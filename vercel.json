{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/css/(.+)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.+)",
      "dest": "/js/$1"
    },
    {
      "src": "/images/(.+)",
      "dest": "/images/$1"
    },
    {
      "src": "/fonts/(.+)",
      "dest": "/fonts/$1"
    },
    {
      "src": "/icon/(.+)",
      "dest": "/icon/$1"
    },
    {
      "src": "/.+\\.(html|css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|pdf|pptx|map)",
      "dest": "/$0"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Content-Type", "value": "text/css; charset=utf-8" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    }
  ]
}